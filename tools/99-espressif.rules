# ── Espressif boards on this Pi ──────────────────────────────────────
# ModemManager probes any new ttyACM with AT commands hunting for a
# cellular modem. On an ESP32 that sprays garbage at the board as it
# enumerates and can hijack the port mid-flash. Ignore all of VID 303a.
ACTION=="add|change", SUBSYSTEM=="usb", ATTRS{idVendor}=="303a", ENV{ID_MM_DEVICE_IGNORE}="1"
ACTION=="add|change", SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_PORT_IGNORE}="1"

# Stable per-board names. The ESP32-S3 reports its MAC as the USB serial.
# Matching on vendor alone races: adding the hub already reshuffled ttyACM
# numbering once, and the two gauge panels are near-sequential MACs from the
# same batch — only the full serial tells them apart.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{serial}=="D0:CF:13:24:DB:B8", SYMLINK+="idrive",           MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{serial}=="3C:DC:75:40:0B:F0", SYMLINK+="lighting",         MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{serial}=="68:EE:8F:48:19:9C", SYMLINK+="gauges1 gauges",   MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{serial}=="68:EE:8F:48:18:D4", SYMLINK+="gauges2",          MODE="0666"
